@page "/lobby"
@using PotapanjeBrodovaS2S.Models
@using PotapanjeBrodovaS2S.Models.Utils
@using PotapanjeBrodovaS2S.Servisi
@inject NavigationManager NavManager
@inject Komunikacija Komunikacija
@inject IJSRuntime JS

<!-- DODATI INTERAKTIVNI SERVER PRERENDER FALSE u app.razoru-->
<!-- prvo dodati soba klasu -->
<h1 class="auth-main-title">
    POTAPANJE BRODOVA
</h1>

@if(soba != null && soba.Spremna)//ovde moze pitanje da li moze drugim redosledom
{
    <div class="lobby-panel">

           

        <div class="players">

            <div class="player-card">

                <p>@soba.IgracA.Nadimak</p>
            </div>

            <div class="vs">VS</div>

            <div class="player-card">

                <p>@soba.IgracB.Nadimak</p>
            </div>

        </div>

        @if (Komunikacija.prijavljenIgrac.Nadimak == soba.IgracA.Nadimak)
        {
            <button class="start-btn" @onclick="PokreniIgru">
                Pokreni igru
            </button>
        }
        else
        {
            <p class="waiting-host">
                Čeka se da admin pokrene igru...
            </p>
        }

    </div>
}// prvo ovo kao bez else ovo  gore se dodaje posle, KREIRATI ENUM STANJE SOBE
else if (stanjeSobe == StanjeSobe.IzborOpcije)
{
    <p>@(Komunikacija.prijavljenIgrac.Nadimak), spremni za borbu?</p>
    <button @onclick="KreirajSobu">Kreiraj sobu!</button>
    <button @onclick="()=>{stanjeSobe = StanjeSobe.PridruziSeSobi;}">Pridruzi se sobi!</button>
}else if(stanjeSobe == StanjeSobe.KreirajSobu)
{
    <div class="room-created-panel">

        <button class="close-btn" @onclick="()=>{stanjeSobe = StanjeSobe.IzborOpcije;}" >
            ✕
        </button>

        <h2>SOBA JE KREIRANA</h2>

        <p class="waiting-text">
            Podeli kod sa drugim igračem
        </p>

        <div class="room-code">
            @(soba.Kod)
        </div>

        <p class="waiting-player">
            Čekanje drugog igrača...
        </p>

    </div>
    // sad preci na kod za pravljenje sobe pa tek onda pridruzivanje
}else if(stanjeSobe == StanjeSobe.PridruziSeSobi)
{
    <div class="join-room-panel">

        <button class="close-btn" @onclick="()=>{stanjeSobe = StanjeSobe.IzborOpcije;}">
            ✕
        </button>

                   

        <p class="room-label">Unesi kod sobe</p>

        <input class="player-input room-input"
               type="text"
               maxlength="6"
               @bind="kod"
               @bind:event="oninput"
               />

        <button class="join-btn" @onclick="PridruziSeSobi">
            Pridruži se sobi!
        </button>

    </div>
}

    



@code {
    StanjeSobe stanjeSobe = StanjeSobe.IzborOpcije;

    Soba? soba;
    string kod = "";

    protected override void OnInitialized()
    {
        Komunikacija.SobaSpremnaEvent += OnSobaSpremna;
        Komunikacija.PokreniIgruEvent += OnPokreniIgru;
    }



    public async Task KreirajSobu()
    {
        soba =await Komunikacija.KreirajSobu();
        stanjeSobe = StanjeSobe.KreirajSobu;
    }

    public async Task PridruziSeSobi()
    {
        soba =   await Komunikacija.PridruziSeSobi(kod);
        if(soba == null)
        {
            await JS.InvokeVoidAsync("alert", "Soba ne postoji ili je puna!");
        }
    }


    public void OnSobaSpremna()
    {
        InvokeAsync(() => {
            soba = Komunikacija.trenutnaSoba;
            StateHasChanged();
        });

    }
    private async void PokreniIgru()
    {
        //prvo obavestavamo preko komunikacije i servera drugog igraca da je igra pokrenuta
        await Komunikacija.PokreniIgru();
        //prelazimo na sledecu stranicu
        NavManager.NavigateTo($"/game/{soba.Kod}");
    }

    private void OnPokreniIgru()
    {
        InvokeAsync(() =>
        {
            NavManager.NavigateTo($"/game/{soba.Kod}");
        });
    }
}

